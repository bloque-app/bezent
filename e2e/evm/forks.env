# The pinned forks (F-013, plan DEC-19). One line per network: KEY=value, read by up.sh and the
# scripts. Change a block here and nowhere else.
#
# RPC URLs are not here: up.sh takes POLYGON_RPC_URL, BASE_RPC_URL and BSC_RPC_URL from the
# environment and falls back to public endpoints that serve historical state (a fork at a pinned
# block needs an archive node). Any URL that carries a key belongs in the environment only.

POLYGON_CHAIN_ID=137
POLYGON_BLOCK=95400000
POLYGON_PORT=8545

BASE_CHAIN_ID=8453
BASE_BLOCK=52500000
BASE_PORT=8546

BSC_CHAIN_ID=56
BSC_BLOCK=127300000
BSC_PORT=8547
