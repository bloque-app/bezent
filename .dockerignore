# The build context of deploy/docker/services.Dockerfile (images built in CI only:
# .github/workflows/images.yml). The images need the Rust workspace; the specification, research,
# decks, contracts and the decision form stay out.
.git
.claude
**/target
**/node_modules
.scratch
*.pdf
research
notes
amendments
decisions
brand
contracts
e2e
features
docs
# Secrets and keys never enter the build context (and so never the cache). The published test keys
# are services/signer/fixtures/*.json, which this does not match.
.env*
*.env
*.key
*.pem
*.p12
.vault*
.aws
deploy/**/secrets*
**/*keys*.json
!services/signer/fixtures/test-keys.json
