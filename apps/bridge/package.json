{
  "name": "bezent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "F-018: bezent's bridge web app. Deposit USDC on Polygon through DirectedDeposit, naming a Kreivo recipient; a static, client-only page.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hash": "node scripts/hash.mjs dist"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@polkadot-api/known-chains": "0.12.5",
    "@polkadot-api/smoldot": "0.4.9",
    "@polkadot-api/substrate-bindings": "0.20.3",
    "@scure/base": "1.2.6",
    "@scure/sr25519": "2.4.0",
    "polkadot-api": "2.1.8",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "happy-dom": "20.14.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@polkadot-api/known-chains": "$@polkadot-api/known-chains",
    "@polkadot-api/smoldot": "$@polkadot-api/smoldot"
  }
}
