#
# Parameters of script/DeployVault.s.sol and script/VerifyVault.s.sol, with the recommended values.
# Copy to an untracked config/vault.env, replace every <placeholder>, then:
#
#   set -a; . config/vault.env; set +a
#   forge script script/DeployVault.s.sol --rpc-url <network> --sender <deployer> [--broadcast]
#
# Network constants (tokens, allowances, venue, pinned addresses) are in config/<network>.json. These are the
# parameters that are governance's. Nothing here is a secret: a key never goes in a file or in the environment
# (REQ-KY-1); sign with forge's hardware-wallet or keystore options. script/VerifyVault.s.sol takes the same
# parameters, plus the addresses the deployment printed (see its header).
#
# The values of the two VAULT_DELAY_* lines are read by the Foundry tests (test/fork/VaultFork.sol), which deploy
# with them, so this file cannot drift from what the tests prove.

# polygon | base | bsc
NETWORK=polygon

# Governance: several independent signers (REQ-KY-5). The script refuses a threshold below 2.
VAULT_OWNERS=<owner-1>,<owner-2>,<owner-3>
VAULT_THRESHOLD=2

# The role keys: separate from each other and from the owners (REQ-KY-4). Polygon only for the conversion
# member (the others carry no conversion role, DEC-13): leave it unset there.
DELIVERY_MEMBER=<delivery-key>
CONVERSION_MEMBER=<conversion-key>

# The Zodiac Delay modifier (REQ-GV-3), in seconds.
#
# Cooldown: how long a queued change waits before anyone can run it. This is the window in which the owners'
# co-signers, the monitors and the public can see a widening change and veto it (Delay.setTxNonce is offered to
# the owners at once). 86400 is 24 hours.
VAULT_DELAY_COOLDOWN=86400
# Expiration: how long a change stays runnable after its cooldown. Past it the change is dead and has to be
# queued again; a stale change cannot be run months later. The Delay needs at least 60. 604800 is 7 days.
VAULT_DELAY_EXPIRATION=604800

# Optional: pins the Safe's salt nonce; by default it is derived from the network, the deployer and its nonce.
# VAULT_SALT_NONCE=
